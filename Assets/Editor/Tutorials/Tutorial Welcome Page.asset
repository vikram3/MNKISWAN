  m_Image: {fileID: 2800000, guid: 240734f1e1c8daa4b9bd0593e767fb3f, type: 3}
  m_WindowTitle:
    m_Untranslated: Welcome
  m_Title:
    m_Untranslated: 'Boss Room: Small Scale Co-op Sample'
  m_Description:
    m_Untranslated: 'This sample is an 8-player online multiplayer co-op game showcasing
      Netcode for GameObjects'' (Netcode) networking stack.


      It uses Netcode
      to enable communication between remote clients, and leverages several Unity
      Gaming Services to facilitate connectivity between players.


      To use
      those services, follow the tutorials within this project. (Or use Boss Room
      without them.)


      You can host a game, or join an existing one, from the
      Startup scene.'
  m_Buttons:
  - Text:
      m_Untranslated: I'll explore on my own
